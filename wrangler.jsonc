{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-live",
  "main": "worker/index.ts",
  // Newest date the test pool's bundled workerd accepts; raise it together with the pool
  "compatibility_date": "2026-08-22",
  "assets": {
    // SPA: unknown paths fall back to index.html; /api and /ws hit the Worker first
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // Free plan requires SQLite-backed DOs even though RoomDO never touches storage
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // Per-IP cap on WebSocket connection attempts (eventually consistent, so a guard rail, not a hard wall)
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // A socket that never says hello is closed after this long (swept when the next one connects)
    "HELLO_TIMEOUT_MS": "10000"
  },
  "observability": { "enabled": true }
}
